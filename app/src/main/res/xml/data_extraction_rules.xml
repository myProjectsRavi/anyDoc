<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="docforge_settings.xml" />
        <exclude domain="database" path="docforge.db" />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="docforge_settings.xml" />
        <exclude domain="database" path="docforge.db" />
    </device-transfer>
</data-extraction-rules>
